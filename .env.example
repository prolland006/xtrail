# --- PostgreSQL / PostGIS (docker-compose) ---
POSTGRES_DB=xtrail
POSTGRES_USER=xtrail
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# --- Connexion utilisée par Next.js (Prisma, à venir) ---
# Doit rester cohérente avec les 4 variables ci-dessus.
DATABASE_URL=postgresql://xtrail:changeme@localhost:5432/xtrail?schema=public

# --- Strava OAuth ---
# Créés depuis https://www.strava.com/settings/api. Le redirect_uri doit correspondre
# exactement (schéma, host, port, chemin) à celui déclaré dans l'application Strava.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
# How many recent activities to backfill on first connect. Optional — defaults to 50.
STRAVA_INITIAL_SYNC_ACTIVITIES=50

# --- Strava Webhook ---
# Choisi par nous (chaîne aléatoire), pas fourni par Strava. Renseigné lors de la création de
# la subscription (endpoint admin, à venir) et revérifié à chaque handshake GET sur
# /api/webhooks/strava.
STRAVA_WEBHOOK_VERIFY_TOKEN=
