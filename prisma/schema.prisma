generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every source of activities the app can import from. Strava is the only real one today;
// adding Garmin/Coros/etc. later means adding a value here — no other model needs to change
// shape to accommodate a new provider.
enum ActivityProvider {
  strava
}

model Player {
  id        Int      @id @default(autoincrement())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  photoUrl  String   @map("photo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  externalConnections ExternalConnection[]
  activities          Activity[]
  hexagonVisits       ActivityHexagon[]
  ownedTerritories    Territory[]

  @@map("players")
}

// One row per (player, provider): a player can connect Strava AND Garmin, but only once each.
// Separate from Player since OAuth tokens have a different lifecycle (revoked/reconnected)
// than the player's profile.
model ExternalConnection {
  id       Int              @id @default(autoincrement())
  playerId Int              @map("player_id")
  provider ActivityProvider

  // The athlete/user id on the provider's own side (Strava's athlete id, Garmin's user id...).
  // Kept as a string rather than typed per-provider (e.g. BigInt for Strava) since we can't
  // assume every future provider's id is numeric.
  externalAccountId String @map("external_account_id")

  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  scope        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // At most one connection per player per provider.
  @@unique([playerId, provider], name: "playerProvider")
  // How a webhook/worker turns "owner_id on provider X" back into one of our players.
  @@unique([provider, externalAccountId], name: "providerAccount")
  @@map("external_connections")
}

model Activity {
  id Int @id @default(autoincrement())

  // Which platform this came from, and its id there — together the natural key. Not typed
  // per-provider (no more "stravaId") so importing from a second provider never requires a
  // schema change here, only a new ActivityProvider value.
  provider           ActivityProvider
  providerActivityId String           @map("provider_activity_id")

  playerId Int @map("player_id")

  name      String
  type      String
  startDate DateTime @map("start_date")

  distanceMeters      Float @map("distance_meters")
  movingTimeSeconds   Int   @map("moving_time_seconds")
  elevationGainMeters Float @map("elevation_gain_meters")

  // Encoded polyline in the same format lib/polyline.ts decodes — the storage/rendering
  // convention every provider adapter must produce, regardless of that provider's own native
  // track format. No PostGIS geometry column needed today: H3 hex computation happens
  // app-side (h3-js) from the decoded points — see the schema notes for the upgrade path if
  // SQL-level spatial queries are needed later.
  polyline String?

  importedAt DateTime @default(now()) @map("imported_at")
  // Set on creation and bumped whenever a provider "update" event (e.g. rename, sport type
  // change) is applied to this row. Historical immutability means we still never recompute
  // distance/elevation/hexagons on update — only the fields the provider itself reports changed.
  updatedAt DateTime @updatedAt @map("updated_at")

  player   Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  hexagons ActivityHexagon[]

  @@unique([provider, providerActivityId], name: "providerActivity")
  // Supports "this player's activities, most recent first" — the main read pattern.
  @@index([playerId, startDate])
  @@map("activities")
}

// One row per (activity, hexagon) the activity's route passes through — the fact table
// that makes territory ownership computable and incrementally updatable. `playerId` is
// denormalized from `activity.playerId` so the territory-recompute query (below) never
// needs to join through Activity.
model ActivityHexagon {
  activityId Int    @map("activity_id")
  playerId   Int    @map("player_id")
  h3Index    String @map("h3_index") @db.VarChar(20)

  // Distance covered by this activity specifically within this hexagon. Not used by the
  // default "most visits wins" ownership rule, but kept so ownership can later be
  // recomputed by distance instead of visit count without a schema change.
  distanceMeters Float @map("distance_meters")

  // Time spent inside this hexagon. Always null for now: a summary polyline (what we
  // currently import) has no per-point timestamps to derive this from. Populating it would
  // require switching to a provider's detailed activity streams (time + latlng streams).
  durationSeconds Float? @map("duration_seconds")

  // Used only to break ties in territory ownership (see updateTerritoriesForHexagons):
  // among players with an equal visit count on a hexagon, the one whose most recent
  // visit is newest wins. Deliberately the only audit field on this table — everything
  // else about "when" is available via the related Activity.startDate.
  createdAt DateTime @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Natural key: an activity visits a given hexagon at most once (enforces "seuls les
  // hexagones concernés" idempotently on re-import) and doubles as the index for
  // per-activity lookups (e.g. deleting/re-importing one activity's hex rows).
  @@id([activityId, h3Index])
  // The hot-path query: "for this hexagon, how many visits does each player have" —
  // an index-only scan, no join to Activity required.
  @@index([h3Index, playerId])
  @@map("activity_hexagons")
}

// Materialized "who currently owns this hexagon" — recomputed only for the hexagons
// touched by a newly imported activity. The map reads only this table, never the
// full ActivityHexagon history.
model Territory {
  h3Index String @id @map("h3_index") @db.VarChar(20)

  ownerId       Int?  @map("owner_id")
  // The winning player's presence score at last recompute (visit count by default —
  // see Activity notes on switching to distance-weighted later).
  ownerPresence Float @map("owner_presence")

  // Cell centroid, cached at write time (see updateTerritoriesForHexagons) purely so the map
  // can filter by viewport with a plain indexed bbox query. Without this, "which territories
  // are on screen" would mean loading every territory row and deriving lat/lng from h3Index
  // with h3-js on every request — measured at ~112k rows, that alone took 2.2s server-side
  // and produced a 93MB GeoJSON payload regardless of what was actually visible.
  centerLat Float @map("center_lat")
  centerLng Float @map("center_lng")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // SetNull rather than Cascade: deleting a player shouldn't delete the hexagon's
  // ownership record, just leave it unowned until the next recompute touches it again.
  owner Player? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  // The map's hot-path query: "territories whose centroid falls within this viewport".
  @@index([centerLat, centerLng])
  @@map("territories")
}

enum ActivitySyncAspect {
  create
  update
  delete
}

enum ActivitySyncJobStatus {
  pending
  processing
  completed
  failed
}

// Queue of provider webhook events awaiting processing by the worker. A webhook handler's
// only DB write is inserting one row here (after checking the owner is a known player) — all
// calls to a provider's API and H3/territory processing happen later, out of the request path.
// Shared across providers: a future Garmin webhook enqueues into this same table and the same
// worker, distinguished only by `provider`.
model ActivitySyncJob {
  id Int @id @default(autoincrement())

  provider           ActivityProvider
  providerActivityId String           @map("provider_activity_id")
  // The provider's athlete/user id (webhook payload's owner). The worker re-resolves the
  // ExternalConnection from this at process time rather than the job carrying a playerId, so
  // an account disconnected between enqueue and processing is naturally handled.
  externalAccountId String @map("external_account_id")

  aspectType ActivitySyncAspect @map("event_type")
  // The webhook payload's own event time (when the change happened on the provider's side,
  // not when we received it). Combined with provider + providerActivityId + aspectType, this
  // is what makes enqueueing idempotent: a redelivered event hits the unique constraint below
  // instead of creating a second job.
  eventTime DateTime @map("event_time")

  status    ActivitySyncJobStatus @default(pending)
  attempts  Int                   @default(0)
  lastError String?               @map("last_error")

  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([provider, providerActivityId, aspectType, eventTime], name: "providerEvent")
  // The worker's dequeue query: oldest pending jobs first.
  @@index([status, createdAt])
  @@map("activity_sync_jobs")
}
